#!/usr/bin/env python3
# grafo_server.py — sirve el grafo del Cerebro Satori SOLO en loopback (127.0.0.1),
# regenerándolo on-demand (cache 60s) para que el botón del Despacho de Sato lo abra siempre fresco.
#
# Bastión (controles duros, NO tocar sin motivo):
#   · HOST = 127.0.0.1  → SOLO loopback. Jamás 0.0.0.0 (eso lo expondría a toda la LAN).
#   · Sirve UN SOLO archivo (GRAFO.html), ignora la ruta → sin path-traversal al resto del vault.
#   · Sin escritura, sin parámetros del cliente que lleguen a disco o a shell.
#
# Uso manual:  python3 grafo_server.py      → http://127.0.0.1:8788/
# En produccion lo levanta launchd (com.satori.cerebro-grafo), ver el .plist hermano.
import http.server, os, subprocess, sys, threading, time

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
GRAFO = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "GRAFO.html"))   # _cerebro/GRAFO.html
GEN   = os.path.join(SCRIPT_DIR, "grafo.py")
HOST  = "127.0.0.1"   # loopback SOLO — control Bastión, no cambiar a 0.0.0.0
PORT  = 8788          # vecino del orbe de voz (8787)
_last = [0.0]
_regen_lock = threading.Lock()   # R13: con hilos, sin esto N requests lanzan N grafo.py a la vez

def _quejarse(msg):
    """R4 · única salida de diagnóstico del server. Va a stderr ⇒ al StandardErrorPath del
    LaunchAgent (~/Library/Logs/satori-grafo-server.err.log). Nunca lanza: si ni siquiera se
    puede loguear, el server igual sigue sirviendo."""
    try:
        print("[%s] %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), msg), file=sys.stderr, flush=True)
    except Exception:
        pass


def _regen():
    """Regenera GRAFO.html on-demand, con cache de 60s (no re-walkear el vault en ráfaga).
    Fail-safe: si grafo.py falla o tarda, servimos lo último que haya en disco."""
    now = time.time()
    if now - _last[0] < 60:
        return
    # R13 · un solo regen a la vez. El que no toma el lock NO espera: sirve la copia en disco
    # (que es exactamente lo que _regen promete en su fail-safe) en vez de encolarse 10 s.
    if not _regen_lock.acquire(blocking=False):
        return
    try:
        # sys.executable, NO "python3": bajo launchd el PATH es mínimo y "python3" resuelve al de
        # CommandLineTools, que no tiene permiso TCC sobre ~/Documents. El regen fallaría en
        # silencio (está en try/except) y el grafo se serviría eternamente stale.
        r = subprocess.run([sys.executable, GEN], cwd=SCRIPT_DIR, timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if r.returncode != 0:
            # R4: un regen que falla NO puede ser silencioso. Antes esto caía en `except: pass`
            # y el grafo se servía eternamente stale con 200 OK — el error se tragaba y el
            # err.log quedaba en 0 bytes. Regla del proyecto: todo catch que traga, avisa.
            _quejarse("grafo.py salió con código %d: %s" % (
                r.returncode, (r.stderr or b"").decode("utf8", "replace").strip()[:400]))
            # Backoff: reintentar en ~15 s, no en cada request (un grafo.py roto lanzaría un
            # subproceso por visita) y no a los 60 s (tarda de más en recuperarse).
            _last[0] = now - 45
            return
        _last[0] = now
    except subprocess.TimeoutExpired:
        _quejarse("grafo.py excedió el timeout de 10 s — se sirve la copia en disco")
        _last[0] = time.time() - 45          # mismo backoff que el returncode != 0
    except Exception as e:
        # Se sigue sin romper el server (esa parte estaba bien), pero ahora se DICE.
        _quejarse("regen falló: %s: %s" % (type(e).__name__, e))
    finally:
        _regen_lock.release()

class H(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        _regen()
        try:
            with open(GRAFO, "rb") as f:
                body = f.read()
        except OSError:
            self.send_error(404, "GRAFO.html no existe todavia — corré grafo.py una vez")
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass  # sin logs ruidosos

if __name__ == "__main__":
    print("Cerebro grafo → http://%s:%d/  (loopback · Ctrl-C para cortar)" % (HOST, PORT))
    # R13: ThreadingHTTPServer — con el HTTPServer single-thread, un regen lento bloqueaba
    # cada request. Con hilos, el regen lo hace UNO solo (lock) y el resto sirve disco.
    srv = http.server.ThreadingHTTPServer((HOST, PORT), H)
    srv.daemon_threads = True
    srv.serve_forever()
